#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# 1. Prefer compiled server/CLI binary if present
if [ -x "$PROJECT_DIR/build/server_build/cloudflare-manager-server" ]; then
  exec "$PROJECT_DIR/build/server_build/cloudflare-manager-server" "$@"
fi

# 2. Check if a Flutter macos app build exists
APP_BIN="$PROJECT_DIR/build/macos/Build/Products/Release/Cloudflare Manager.app/Contents/MacOS/Cloudflare Manager"
if [ -x "$APP_BIN" ]; then
  exec "$APP_BIN" "$@"
fi

# 3. Fall back to dart run
DART_BIN=""
if command -v dart &>/dev/null; then
  DART_BIN="dart"
elif [ -x "/opt/homebrew/bin/dart" ]; then
  DART_BIN="/opt/homebrew/bin/dart"
elif [ -x "/usr/local/bin/dart" ]; then
  DART_BIN="/usr/local/bin/dart"
elif [ -n "${HOME:-}" ] && [ -x "$HOME/App/flutter/bin/dart" ]; then
  DART_BIN="$HOME/App/flutter/bin/dart"
elif [ -n "${HOME:-}" ] && [ -x "$HOME/flutter/bin/dart" ]; then
  DART_BIN="$HOME/flutter/bin/dart"
fi

if [ -n "$DART_BIN" ]; then
  exec "$DART_BIN" run "$SCRIPT_DIR/cloudflare_manager.dart" "$@"
fi

echo "Error: Neither compiled binary nor dart was found." >&2
exit 1
